
# ------------------------------------------------------------------
# POSTGRES (control plane + agent pool su DUE database distinti)
# ------------------------------------------------------------------
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: localai-pg-init-{{ .group }}
  namespace: {{ .namespace }}
data:
  01-agents-db.sql: |
    CREATE DATABASE localai_agents OWNER localai;
    GRANT pg_read_all_stats TO localai;
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: localai-pg-{{ .group }}
  namespace: {{ .namespace }}
  labels:
    group: "{{ .group }}"
    role: control-plane-db
spec:
  serviceName: localai-pg-{{ .group }}
  replicas: 1
  selector:
    matchLabels:
      app: {{ .group }}_pg
  template:
    metadata:
      labels:
        app: {{ .group }}_pg
        group: "{{ .group }}"
        role: control-plane-db
    spec:
      schedulerName: {{ .schedulerName }}
      containers:
        - name: postgres
          image: quay.io/mudler/localrecall:v0.5.5-postgresql   # pgvector incluso
          env:
            - { name: POSTGRES_DB, value: "localai" }
            - { name: POSTGRES_USER, value: "localai" }
            - { name: POSTGRES_PASSWORD, value: "localai" }
          ports:
            - containerPort: 5432
          readinessProbe:
            exec:
              command: ["pg_isready", "-U", "localai"]
            periodSeconds: 5
          volumeMounts:
            - { name: data, mountPath: /var/lib/postgresql }
            - { name: init, mountPath: /docker-entrypoint-initdb.d }
      volumes:
        - name: init
          configMap:
            name: localai-pg-init-{{ .group }}
  volumeClaimTemplates:
    - metadata:
        name: data
      spec:
        accessModes: ["ReadWriteOnce"]
        resources:
          requests:
            storage: 5Gi
---
apiVersion: v1
kind: Service
metadata:
  name: localai-pg-{{ .group }}
  namespace: {{ .namespace }}
spec:
  selector:
    app: {{ .group }}_pg
  ports:
    - { name: tcp-pg, port: 5432, targetPort: 5432 }

# ------------------------------------------------------------------
# NATS (bus di controllo: backend.install, staging, eventi cache)
# ------------------------------------------------------------------
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: localai-nats-{{ .group }}
  namespace: {{ .namespace }}
  labels:
    group: "{{ .group }}"
    role: control-plane-bus
spec:
  replicas: 1
  selector:
    matchLabels:
      app: {{ .group }}_nats
  template:
    metadata:
      labels:
        app: {{ .group }}_nats
        group: "{{ .group }}"
        role: control-plane-bus
    spec:
      schedulerName: {{ .schedulerName }}
      containers:
        - name: nats
          image: nats:2-alpine
          args: ["--js", "-m", "8222"]
          ports:
            - containerPort: 4222
            - containerPort: 8222
          readinessProbe:
            httpGet: { path: /healthz, port: 8222 }
            periodSeconds: 5
---
apiVersion: v1
kind: Service
metadata:
  name: localai-nats-{{ .group }}
  namespace: {{ .namespace }}
spec:
  selector:
    app: {{ .group }}_nats
  ports:
    - { name: tcp-nats, port: 4222, targetPort: 4222 }
    - { name: http-monitor, port: 8222, targetPort: 8222 }

# ------------------------------------------------------------------
# FRONTEND (stateless: SmartRouter + API; scalabile in repliche)
# ------------------------------------------------------------------
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: localai-scheduling-{{ .group }}
  namespace: {{ .namespace }}
data:
  scheduling.yaml: |
{{ if .schedulingYAML }}{{ .schedulingYAML | indent 4 }}{{ else }}    []{{ end }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: localai-frontend-{{ .group }}
  namespace: {{ .namespace }}
  labels:
    group: "{{ .group }}"
    role: frontend
spec:
  replicas: {{ or .frontendReplicas 1 }}
  selector:
    matchLabels:
      app: {{ .group }}_frontend
  template:
    metadata:
      labels:
        app: {{ .group }}_frontend
        group: "{{ .group }}"
        role: frontend
    spec:
      schedulerName: {{ .schedulerName }}
      {{ if .modelConfig }}
      initContainers:
        - name: preload-model-config
          image: busybox:1.36
          command: ["sh", "-c", "cat > /models/{{ .modelConfig }} <<'EOF'\n{{ .modelConfigContent }}\nEOF"]
          volumeMounts:
            - { name: models, mountPath: /models }
      {{ end }}
      containers:
        - name: local-ai
          image: localai/localai:master-cpu
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 8080
          env:
            - { name: LOCALAI_DISTRIBUTED, value: "true" }
            - { name: LOCALAI_NATS_URL, value: "nats://localai-nats-{{ .group }}:4222" }
            - { name: LOCALAI_REGISTRATION_TOKEN, value: "{{ .registrationToken }}" }
            - { name: LOCALAI_REGISTRATION_REQUIRE_AUTH, value: "true" }
            - { name: LOCALAI_AUTO_APPROVE_NODES, value: "true" }    # ok per esperimenti
            - { name: LOCALAI_AUTH, value: "true" }                   # obbligatorio in distributed
            - name: LOCALAI_AUTH_DATABASE_URL
              value: "postgresql://localai:localai@localai-pg-{{ .group }}:5432/localai?sslmode=disable"
            - name: LOCALAI_AGENT_POOL_DATABASE_URL                   # DB separato (vedi doc)
              value: "postgresql://localai:localai@localai-pg-{{ .group }}:5432/localai_agents?sslmode=disable"
            - { name: LOCALAI_EXPOSE_NODE_HEADER, value: "true" }     # X-LocalAI-Node per le misure
            - { name: LOCALAI_MODEL_SCHEDULING_CONFIG, value: "/etc/localai/scheduling.yaml" }
            - { name: LOCALAI_VRAM_WARM_LIMIT, value: "0" }
            - { name: MODELS_PATH, value: "/models" }
            - { name: LOCALAI_LOG_LEVEL, value: "debug" }
          readinessProbe:
            httpGet: { path: /readyz, port: 8080 }
            periodSeconds: 10
          livenessProbe:
            httpGet: { path: /healthz, port: 8080 }
            periodSeconds: 20
            failureThreshold: 6
          volumeMounts:
            - { name: models, mountPath: /models }
            - { name: scheduling, mountPath: /etc/localai }
      volumes:
        - name: models
          emptyDir: {}            # oppure il tuo models_pvc
        - name: scheduling
          configMap:
            name: localai-scheduling-{{ .group }}
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              - matchExpressions:
                  - key: node-role.kubernetes.io/control-plane
                    operator: DoesNotExist
---
apiVersion: v1
kind: Service
metadata:
  name: localai-frontend-{{ .group }}
  namespace: {{ .namespace }}
  labels:
    group: "{{ .group }}"
spec:
  selector:
    app: {{ .group }}_frontend
  ports:
    - { name: http, port: 8080, targetPort: 8080 }

# ------------------------------------------------------------------
# WORKER generici (nessun backend fisso: lo installa lo SmartRouter)
# ------------------------------------------------------------------
{{ range $i := until (or .numWorker 0) }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: localai-dworker-{{ $.group }}-{{ $i }}
  namespace: {{ $.namespace }}
  labels:
    group: "{{ $.group }}"
    role: worker
spec:
  replicas: 1
  selector:
    matchLabels:
      app: {{ $.group }}_dworker_{{ $i }}
  template:
    metadata:
      labels:
        app: {{ $.group }}_dworker_{{ $i }}
        group: "{{ $.group }}"
        role: worker
    spec:
      schedulerName: {{ $.schedulerName }}
      {{ if $.workerNodeName }}
      nodeSelector:
        kubernetes.io/hostname: {{ $.workerNodeName }}
      {{ end }}
      containers:
        - name: worker
          image: localai/localai:master-cpu
          imagePullPolicy: IfNotPresent
          args: ["worker"]
          env:
            - name: POD_IP
              valueFrom: { fieldRef: { fieldPath: status.podIP } }
            - name: POD_NAME
              valueFrom: { fieldRef: { fieldPath: metadata.name } }
            - name: NODE_NAME
              valueFrom: { fieldRef: { fieldPath: spec.nodeName } }
            - { name: LOCALAI_SERVE_ADDR, value: "0.0.0.0:50051" }
            - { name: LOCALAI_GRPC_MAX_PORT, value: "50100" }
            - { name: LOCALAI_ADVERTISE_ADDR, value: "$(POD_IP):50051" }
            - { name: LOCALAI_ADVERTISE_HTTP_ADDR, value: "$(POD_IP):50050" }
            - { name: LOCALAI_REGISTER_TO, value: "http://localai-frontend-{{ $.group }}:8080" }
            - { name: LOCALAI_NATS_URL, value: "nats://localai-nats-{{ $.group }}:4222" }
            - { name: LOCALAI_REGISTRATION_TOKEN, value: "{{ $.registrationToken }}" }
            - { name: LOCALAI_REGISTRATION_REQUIRE_AUTH, value: "true" }
            - { name: LOCALAI_NODE_NAME, value: "$(POD_NAME)" }
            # Ponte K8s -> SmartRouter: il nodo K8s diventa una label usabile
            # nei node_selector per-modello (la zona si aggiunge via PATCH
            # /api/nodes/:id/labels dall'executor, che conosce node->zona).
            - { name: LOCALAI_NODE_LABELS, value: "k8s.node=$(NODE_NAME),group={{ $.group }}" }
            - { name: LOCALAI_HEARTBEAT_INTERVAL, value: "10s" }
            - { name: LOCALAI_BACKENDS_PATH, value: "/backends/amd64" }  # backend pre-installati: niente download a runtime
            - { name: MODELS_PATH, value: "/models" }
            - { name: LOCALAI_LOG_LEVEL, value: "debug" }
          ports:
            - containerPort: 50050   # HTTP file transfer + probe
            - containerPort: 50051   # prima porta gRPC backend
          readinessProbe:
            httpGet: { path: /readyz, port: 50050 }
            periodSeconds: 10
          livenessProbe:
            httpGet: { path: /healthz, port: 50050 }
            periodSeconds: 20
          {{ if $.workerMemoryLimitGi }}
          resources:
            limits:
              memory: "{{ $.workerMemoryLimitGi }}Gi"
          {{ end }}
          volumeMounts:
            - { name: lxcfs-proc-meminfo, mountPath: /proc/meminfo, readOnly: true }
            - { name: local-backends, mountPath: /backends }
            - { name: models, mountPath: /models }
      volumes:
        - name: lxcfs-proc-meminfo
          hostPath:
            path: /var/lib/lxcfs/proc/meminfo
        - name: local-backends
          persistentVolumeClaim:
            claimName: localai-backend-all-pvc
        - name: models
          emptyDir: {}               # staging HTTP dal frontend
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              - matchExpressions:
                  - key: node-role.kubernetes.io/control-plane
                    operator: DoesNotExist
                  - key: node-role
                    operator: NotIn
                    values: ["management"]
{{ end }}
